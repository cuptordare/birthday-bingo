# Copy this file to .env and fill in real values before running `npm run build`,
# `npm run dev`, or `npm run encrypt-content`. See DEPLOYMENT.md for where these
# values come from.
APP_DATA_URL=
APP_DATA_SECRET=

# 32-byte AES-256 key, base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required both to encrypt content (npm run encrypt-content) and to build the
# app (the client decrypts game content with this same key at runtime).
GAME_CONTENT_KEY=
